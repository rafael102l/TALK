# Copy to apps/api/.env

# Local Docker Postgres: npm run db:up
DATABASE_URL=postgresql://talk:talk@localhost:5432/talk
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-string
OTP_DEV_CODE=000000
CONTACT_HASH_SALT=talk-contact-salt-change-me
API_PUBLIC_URL=http://localhost:3000
PORT=3000

# Optional — SMS OTP + invite (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Optional — Speech to text
DEEPGRAM_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional — Translation
DEEPL_API_KEY=

# Optional — Vapi (voice agents; not used for PTT translation fan-out)
VAPI_API_KEY=

# Optional — Voice clone + TTS
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_v3

# Optional — email for device transfer codes
RESEND_API_KEY=
RESEND_FROM=
