{
  "expo": {
    "name": "TALK",
    "slug": "talk",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "talk",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.talk.ptt",
      "entitlements": {
        "aps-environment": "production"
      },
      "infoPlist": {
        "NSMicrophoneUsageDescription": "TALK צריך מיקרופון כדי לתמלל שידורים במכשיר.",
        "NSSpeechRecognitionUsageDescription": "TALK מתמלל שידורים במכשיר כדי לתרגם בחינם.",
        "NSContactsUsageDescription": "TALK משתמש באנשי הקשר כדי למצוא מי כבר באפליקציה.",
        "NSPhotoLibraryUsageDescription": "TALK צריך תמונה כדי להציג אותך לחברים.",
        "NSCameraUsageDescription": "TALK צריך מצלמה כדי לצלם תמונה או סרטון.",
        "UIBackgroundModes": [
          "audio",
          "remote-notification",
          "voip"
        ]
      }
    },
    "android": {
      "package": "app.talk.ptt",
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.CALL_PHONE",
        "android.permission.READ_PHONE_STATE",
        "android.permission.READ_PHONE_NUMBERS",
        "android.permission.MANAGE_OWN_CALLS",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.FOREGROUND_SERVICE_PHONE_CALL",
        "android.permission.BIND_TELECOM_CONNECTION_SERVICE",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "expo-secure-store",
      "expo-av",
      "expo-contacts",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "TALK צריך תמונה כדי להציג אותך לחברים.",
          "cameraPermission": "TALK צריך מצלמה כדי לצלם תמונה או סרטון.",
          "microphonePermission": "TALK צריך מיקרופון כדי לצלם סרטון."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "TALK צריך מיקרופון כדי לתמלל שידורים במכשיר.",
          "speechRecognitionPermission": "TALK מתמלל שידורים במכשיר כדי לתרגם בחינם."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://talk-2-8lqz.onrender.com",
      "router": {},
      "eas": {
        "projectId": "fb8dfb56-86af-45c1-aa8b-8f2106d26e51"
      }
    },
    "owner": "refael33"
  }
}
